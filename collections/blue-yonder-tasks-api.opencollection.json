{
  "opencollection": "1.0.0",
  "info": {
    "name": "Blue Yonder Warehouse Management Inventory Tasks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://auth.blueyonder.example.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List warehouse tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blueyonder.example.com/wms/v1/tasks",
            "params": [
              {
                "name": "taskType",
                "value": "",
                "type": "query"
              },
              {
                "name": "assignedTo",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve warehouse tasks (pick, put, move, count) for assignment and tracking."
        }
      ]
    }
  ],
  "bundled": true
}